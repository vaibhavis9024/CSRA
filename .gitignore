# Environment variables
.env
.env.*
!.env.example

# Python virtual environments
.venv/
venv/
env/
ENV/

# Byte-compiled / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Build & distribution artifacts
build/
dist/
*.egg-info/
*.egg

# IDE & editor files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs & local databases
*.log
logs/
*.db
*.sqlite
*.sqlite3

# Temporary files
tmp/
temp/
*.tmp

# Evaluation results (keep .gitkeep, exclude generated runs)
data/evals/results/*
!data/evals/results/.gitkeep
