# Application
APP_ENV=development
APP_NAME=CSRA
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# Cloudflare Workers AI (single API key + Account ID for all evaluation models)
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
# Optional override (defaults to https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1)
CLOUDFLARE_BASE_URL=

# Application LLM Defaults (routed through Cloudflare Workers AI)
LLM_PROVIDER=cloudflare
LLM_MODEL_NAME=@cf/meta/llama-3.3-70b-instruct-fp8-fast
